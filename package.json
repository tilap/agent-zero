{
  "name": "agent-zero",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "Julien La Vinh <jlavinh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilap/agent-zero.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
